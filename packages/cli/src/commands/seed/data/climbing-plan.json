  "glossary": [
    {
      "term": "RPE",
      "definition": "Rate of Perceived Exertion, 1-10. RPE 7 = challenging, 3+ reps in reserve. RPE 8 = 1-2 reps left. RPE 9 = 1 rep left. RPE 10 = absolute max."
    },
    { "term": "DB", "definition": "Dumbbell." },
    {
      "term": "ARC",
      "definition": "Aerobic Restoration and Capillarity: continuous very easy climbing for 20-45 min to build aerobic base and recovery."
    },
    {
      "term": "MVC-7",
      "definition": "Maximum voluntary contraction over a 7 second pull, measured with the Tindeq."
    },
    {
      "term": "4x4",
      "definition": "4 problems back-to-back, 4 min rest, 4 rounds."
    },
    {
      "term": "Open-hand",
      "definition": "Grip with fingers extended and relaxed, no crimping. The athlete's weakest grip and the main hangboard focus."
    }
  ],

  "coach_notes": [
    "Crimp is not the limiter. Force open-hand on the hangboard even when it feels weak.",
    "5 days is aggressive for training age zero. Drop to 4 days if systemically fatigued.",
    "Slopers are half technique: hip drive, momentum, body position. Seek out sloper problems.",
    "Gym push/pull balance protects shoulders and builds the definition the athlete wants.",
    "Never skip deloads. Max 3 hard weeks in a row.",
    "Do not skip legs: RDLs and squats transfer to compression and overhangs.",
    "Protein 1.6-2 g per kg bodyweight daily for visible muscle definition.",
    "Log gym lifts and add 1-2 kg when all reps are clean.",
    "V6-V7 in 12 weeks is realistic given the finger strength baseline."
  ]
}
