  "progression_rules": [
    {
      "id": "gym_overload",
      "applies_to": "gym",
      "rule": "Add 1-2 kg to a lift once all reps are completed cleanly. Log every session."
    },
    {
      "id": "gym_intensity",
      "applies_to": "gym",
      "rule": "Stay around RPE 7, never grind to failure as a beginner. Rest 60-90s between sets."
    },
    {
      "id": "repeaters_volume",
      "applies_to": "open_hand_repeaters",
      "rule": "Week 1: 3 sets, week 2: 4 sets, week 3: 5 sets."
    },
    {
      "id": "deload_cadence",
      "applies_to": "plan",
      "rule": "Never more than 3 hard weeks in a row. Deload weeks are mandatory."
    },
    {
      "id": "fatigue_valve",
      "applies_to": "plan",
      "rule": "If systemically fatigued (tired, unmotivated, sleeping poorly), drop from 5 to 4 climbing days. Re-add the 5th in block 2."
    },
    {
      "id": "gym_block3",
      "applies_to": "gym",
      "rule": "Block 3 gym is maintenance: hold load, no failure, no PR chasing."
    }
  ],

  "tindeq": {
    "baseline_test": {
      "when": "Before week 1, fresh, after a proper warm-up. Never at the end of a session.",
      "protocol": "Open-hand on 20mm edge: max pull for 7s, 3 attempts, 3 min rest. Best attempt = open-hand MVC-7. Optional: repeat on half-crimp to quantify the open-hand gap.",
      "note": "Athlete has been off climbing for 1+ month; expect numbers below the old 143% BW crimp. Do not chase old numbers in week 1."
    },
    "load_prescription": [
      { "exercise_id": "open_hand_repeaters", "percent_of_mvc": [60, 70] },
