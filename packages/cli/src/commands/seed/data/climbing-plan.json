{
  "schema_version": 1,
  "plan": {
    "id": "boulder-v6-v7-12wk",
    "name": "Bouldering V6-V7 + gym, 12 weeks",
    "duration_weeks": 12,
    "goal": "Send a specific V6 or V7 boulder project",
    "discipline": "bouldering",
    "athlete": {
      "current_grade": "V3-V5",
      "target_grade": "V6-V7",
      "training_age": "0 (no prior structured training)",
      "gym_experience": "beginner",
      "limiters": [
        "open-hand/sloper strength",
        "power endurance",
        "core/body tension"
      ],
      "strengths": [
        "crimp strength: 143% BW on 20mm edge, both hands (measured a year ago)"
      ],
      "equipment": [
        "hangboard",
        "gym/weights",
        "kilter/moonboard/system board",
        "climbing gym",
        "tindeq"
      ],
      "injuries": "none (fully healed)",
      "days_per_week": 5,
      "gym_days_per_week": 2,
      "gym_timing": "morning, before climbing"
    },
    "day_of_week_convention": "1=Monday ... 7=Sunday",
    "slot_values": ["am", "pm", "any"]
  },

  "exercises": [
    {
      "id": "easy_traverse_warmup",
      "name": "Easy traversing warm-up",
      "category": "warmup",
      "equipment": ["wall"],
      "description": "Easy traversing plus joint circles: shoulders, elbows, wrists."
    },
    {
      "id": "progressive_warmup",
      "name": "Progressive climbing warm-up",
      "category": "warmup",
      "equipment": ["wall"],
      "description": "Climb problems of gradually increasing difficulty. Nothing hard."
    },
    {
      "id": "general_gym_warmup",
      "name": "General gym warm-up",
      "category": "warmup",
      "equipment": ["bike"],
      "description": "Leg swings, arm circles, hip circles, 2 min light bike or row."
    },
    {
      "id": "shoulder_warmup",
      "name": "Shoulder and spine warm-up",
      "category": "warmup",
      "equipment": ["band"],
      "description": "Band pull-aparts 2x15, cat-cow, thoracic rotations."
    },
    {
      "id": "arc",
      "name": "ARC (Aerobic Restoration and Capillarity)",
      "category": "endurance",
      "equipment": ["wall"],
      "description": "Continuous easy climbing (V0-V1), barely pumped. If you must stop, it is too hard. Builds capillarity and speeds recovery.",
      "cues": ["straight arms", "silent feet"]
    },
    {
      "id": "silent_feet",
      "name": "Silent feet drill",
      "category": "technique",
      "equipment": ["wall"],
      "description": "Place every foot silently and with intention. Climb slowly."
    },
    {
      "id": "down_climbing",
      "name": "Down-climbing",
      "category": "technique",
      "equipment": ["wall"],
      "description": "Climb up AND back down the same problem."
    },
    {
      "id": "straight_arm_climbing",
      "name": "Straight-arm climbing",
      "category": "technique",
      "equipment": ["wall"],
      "description": "Keep arms straight as long as possible on moderate problems."
    },
    {
      "id": "compression_problems",
      "name": "Compression problems",
      "category": "body_tension",
      "equipment": ["wall"],
      "description": "Compression-style problems squeezing knees together and engaging the whole body."
    },
    {
      "id": "limit_bouldering",
      "name": "Limit bouldering",
      "category": "strength",
      "equipment": ["kilter"],
      "description": "Problems at absolute limit, full rest between attempts. Slopers, compression and body tension styles only. Stop when quality drops."
    },
    {
      "id": "linked_problems",
      "name": "Linked problems",
      "category": "power_endurance",
      "equipment": ["wall"],
      "description": "Several problems linked back-to-back with no rest between them, then rest. Choose problems that mimic the project style."
    },
    {
      "id": "four_by_four",
      "name": "4x4",
      "category": "power_endurance",
      "equipment": ["wall"],
      "description": "4 problems back-to-back with zero rest between them, then 4 min rest, repeated for 4 rounds. Should feel very hard by round 3-4; raise grade if too easy."
    },
    {
      "id": "project_attempts",
      "name": "Project attempts",
      "category": "project",
      "equipment": ["wall"],
      "description": "Work the target V6/V7 project in sections (bottom, crux, top). Track which sections are linked each session."
    },
    {
      "id": "easy_climbing",
      "name": "Easy climbing",
      "category": "recovery",
      "equipment": ["wall"],
      "description": "Easy social or movement-focused climbing, V0-V2 only."
    },

    {
      "id": "open_hand_repeaters",
      "name": "Open-hand repeaters",
      "category": "finger",
      "equipment": ["hangboard", "tindeq"],
      "description": "20mm edge, open-hand grip ONLY (do not default to crimping). 7s on / 3s off x 6 reps = 1 set.",
      "tindeq_load": "60-70% of open-hand MVC-7"
    },
    {
      "id": "max_hangs_open_hand",
      "name": "Max hangs, open-hand",
      "category": "finger",
      "equipment": ["hangboard", "tindeq"],
      "description": "20mm edge, open-hand, 10s hang. Add weight until RPE 8 (struggling at 8-9s).",
      "tindeq_load": "85-90% of open-hand MVC-7"
    },
    {
      "id": "weighted_pullup",
      "name": "Weighted pull-up",
      "category": "pull",
      "equipment": ["pullup_bar", "weight_belt"],
      "description": "Full range of motion, 3 min rest between sets."
    },
    {
      "id": "lock_offs",
      "name": "Lock-offs",
      "category": "pull",
      "equipment": ["pullup_bar"],
