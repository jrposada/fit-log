DATA_DIR=/home/jrposada/repos/fit-log/packages/backend/.data
DATABASE_ENDPOINT=mongodb://localhost:3200/fit-log
# Needed by `model-3d reconstruct` to enqueue a reconstruction job.
REDIS_ENDPOINT=redis://localhost:3500
# Optional, `model-3d reconstruct` only. Set this when the worker that will
# process the job runs in the docker-compose `backend` service rather than
# natively — DATA_DIR above is this CLI's own (host) view of the video it
# just wrote; the container sees the same bind-mounted directory at this
# path instead, and the queued job needs to point at whichever one the
# worker will actually read from.
# MODEL_3D_WORKER_DATA_DIR=/repo/packages/backend/.data
TABLE_NAME=fit-log-development

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_ENDPOINT=http://localhost:3380
KEYCLOAK_REALM="FIT Log"
KEYCLOAK_CLIENT_ID=fit-log-mobile

MOONBOARD_USERNAME=
MOONBOARD_PASSWORD=
