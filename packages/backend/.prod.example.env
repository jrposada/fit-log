# Production env for docker-compose.prod.yml. Copy to .env.prod on the server
# (never commit it) and replace every placeholder. See docs/deploy.md.
#
# Used twice: as `--env-file` for compose interpolation (caddy, keycloak,
# keycloak-db) and as the backend's `env_file`.

# Public hostname (no scheme). Caddy requests the Let's Encrypt cert for it.
FITLOG_HOST=fitlog.duckdns.org

# --- Keycloak ---
# Public Keycloak URL, including the /auth path. Also passed to Keycloak as
# KC_HOSTNAME_URL, so it becomes the JWT issuer: must match exactly, or the
# backend rejects every token.
KEYCLOAK_ENDPOINT=https://fitlog.duckdns.org/auth
# The backend fetches signing keys (JWKS) over the compose network instead of
# going out through Caddy. Includes the /auth relative path.
KEYCLOAK_INTERNAL_ENDPOINT=http://keycloak:8080/auth
KEYCLOAK_REALM="FIT Log"
# Bootstrap admin for https://<host>/auth/admin. Use a strong password.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password for Keycloak's Postgres database (user/db are `keycloak`).
KEYCLOAK_DB_PASSWORD=change-me

# --- Backend ---
# Base URL clients load uploaded files from.
PUBLIC_FILES_BASE_URL=https://fitlog.duckdns.org/files
# Compose service names; Mongo runs as single-node replica set rs0.
DATABASE_ENDPOINT=mongodb://database:27017/fit-log
REDIS_ENDPOINT=redis://redis:6379
# Uploaded files; backed by the backend-data volume.
DATA_DIR=/data
