ALLOWED_ORIGIN=
DATA_DIR=/home/jrposada/repos/fit-log/packages/backend/.data
DATABASE_ENDPOINT=mongodb://localhost:3200/fit-log
ELASTICSEARCH_ENDPOINT=http://localhost:3400
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_ADMIN=admin
KEYCLOAK_CLIENT_ID=fit-log-backend
# Also passed to Keycloak as KC_HOSTNAME_URL, so it controls the JWT issuer claim.
# Must be reachable by all clients (browser, mobile). Use LAN IP for physical devices.
KEYCLOAK_ENDPOINT=http://localhost:3380
# Optional. Only needed when the backend itself runs in the docker-compose
# `backend` service and KEYCLOAK_ENDPOINT is a LAN IP — that LAN address is
# unreachable from inside the container (Docker Desktop NAT hairpin), so
# this points the backend's own JWKS fetch at the keycloak container
# directly instead. docker-compose.yml already sets this for `backend`.
# KEYCLOAK_INTERNAL_ENDPOINT=http://keycloak:8080
KEYCLOAK_REALM="FIT Log"
# Optional. video-to-3D reconstruction worker — override only if colmap/ffmpeg/ffprobe
# aren't on PATH, or the OpenMVS CLI tools live outside PATH.
# COLMAP_BIN=colmap
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# OPENMVS_BIN_DIR=
# MODEL_3D_RECONSTRUCTION_MAX_FRAMES=200
# MODEL_3D_RECONSTRUCTION_MIN_FRAMES=15
# MODEL_3D_RECONSTRUCTION_STAGE_TIMEOUT_MS=1800000
# Must be reachable by all clients (browser, mobile). Use LAN IP for physical devices.
PUBLIC_FILES_BASE_URL=http://172.20.10.3:3100/files
REDIS_ENDPOINT=redis://localhost:3500
